# Application
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/ai_workspace

# JWT

SECRET_KEY=replace-with-a-secure-random-secret
ALGORITHM=HS256
```

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public repository ingestion limits
REPOSITORY_CLONE_TIMEOUT_SECONDS=120
REPOSITORY_MAX_FILE_BYTES=1000000
REPOSITORY_MAX_FILES=20000
REPOSITORY_MAX_TOTAL_BYTES=100000000
REPOSITORY_MAX_PROCESSING_SECONDS=120
CODE_CHUNK_MAX_CHARS=8000
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_AUTO_GENERATE=true

# Grounded RAG / LLM generation
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
RAG_RELEVANCE_THRESHOLD=0.0
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_QUESTION_CHARS=4000
